# 复制为 .env 后填值
# Database
DATABASE_URL="file:./dev.db"

# NextAuth.js (issue #1)
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# 管理员 seed(启动时自动创建,首次启动后关闭)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="changeme-on-first-login"
ADMIN_NAME="Admin"
SEED_ADMIN_ENABLED="true"

# 加密盐(用户密码派生 KEK 用)— 生产环境必须替换
APP_SECRET="generate-with-openssl-rand-base64-32"

# ── 大模型(简历优化 / 面试押题)────────────────────────────────────
# 走 OpenAI 兼容协议,DeepSeek 与 MiniMax 都支持。
# 一个都不配也能跑 —— 此时用本地规则引擎兜底(不调模型,不出完整答案稿)。
#
# LLM_PROVIDER   后端:deepseek(默认) / minimax
# LLM_API_KEY    必填。没有 key 就自动退回本地规则引擎。
# LLM_BASE_URL   默认取所选后端的端点,一般不用填
# LLM_MODEL      默认取所选后端的模型(deepseek-chat / MiniMax-M3)
# LLM_THINKING   仅 MiniMax 生效:adaptive / disabled(默认 disabled)
LLM_PROVIDER="deepseek"
LLM_API_KEY=""

# 兼容旧变量:只配了下面这套的话,后端仍按 MiniMax 走(行为与旧版一致)
# MINIMAX_API_KEY=""
# MINIMAX_BASE_URL=""
# MINIMAX_MODEL=""