# Docker 部署用环境变量(由 docker-compose 加载)
# 必须用 `openssl rand -base64 32` 生成真实随机值

# NextAuth session 签名密钥
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32

# Resume.data AES-256-GCM 加密 master key 派生盐
APP_SECRET=replace-with-openssl-rand-base64-32

# 管理员 seed(首次启动自动创建,之后关闭 SEED_ADMIN_ENABLED)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-strong-password
ADMIN_NAME=Admin

# 首次启动后改成 false 防止重复 seed
SEED_ADMIN_ENABLED=true