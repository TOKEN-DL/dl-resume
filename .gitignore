.next/
.next-dev/
out/
dist/
build/
*.tsbuildinfo

# Environment files
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# IDE / editor
.vscode/
!.vscode/settings.json.example
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# OS
desktop.ini

# Testing
coverage/
.nyc_output/

